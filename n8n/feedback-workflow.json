    {
      "parameters": {
        "jsCode": "const textLimits = { studentName: 100, email: 254, courseName: 150, feedbackMessage: 2000 };\nconst emailPattern = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n\nreturn $input.all().map((item) => {\n  const payload = item.json.body ?? item.json;\n  const body = payload && typeof payload === 'object' && !Array.isArray(payload) ? payload : {};\n  const errors = [];\n  const values = {};\n\n  for (const [key, maxLength] of Object.entries(textLimits)) {\n    if (typeof body[key] !== 'string') {\n      errors.push(`${key} must be text`);\n      values[key] = '';\n      continue;\n    }\n    values[key] = body[key].trim();\n    if (!values[key]) errors.push(`${key} is required`);\n    if (values[key].length > maxLength) errors.push(`${key} must be ${maxLength} characters or fewer`);\n  }\n\n  if (values.email && !emailPattern.test(values.email)) errors.push('email must be valid');\n  const rawRating = body.rating;\n  const rating = typeof rawRating === 'number'\n    ? rawRating\n    : typeof rawRating === 'string' && /^[1-5]$/.test(rawRating.trim())\n      ? Number(rawRating.trim())\n      : NaN;\n  if (!Number.isInteger(rating) || rating < 1 || rating > 5) {\n    errors.push('rating must be an integer from 1 to 5');\n  }\n\n  return {\n    json: {\n      isValid: errors.length === 0,\n      errors,\n      ...values,\n      rating: Number.isNaN(rating) ? null : rating,\n      submittedAt: new Date().toISOString()\n    }\n  };\n});"
      },
